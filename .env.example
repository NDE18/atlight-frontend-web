# Copier en .env.local et adapter. Les variables NEXT_PUBLIC_* sont exposées au navigateur :
# n'y mettre aucun secret.

# Racine du backend Spring Boot (REST /api/...). Utilisée par le BFF côté serveur.
NEXT_PUBLIC_API_BASE_URL=https://atlight.fr
# STOMP natif (équivalent mobile : baseURL http→ws + /ws)
NEXT_PUBLIC_WS_URL=wss://atlight.fr/ws
# Domaine des liens de partage publics /p/*
NEXT_PUBLIC_SHARE_BASE_URL=https://atlight.fr

# Firebase (config "web" de lib/firebase_options.dart côté mobile)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=atlight-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=atlight-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=atlight-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=329948153339
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Clé Web Push, à générer dans la console Firebase (Cloud Messaging > Certificats Web Push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Sentry (vide = désactivé)
NEXT_PUBLIC_SENTRY_DSN=
# Build uniquement (CI) : envoi des source maps
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
